<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>MyWhispr</string>
    <key>CFBundleIdentifier</key>
    <string>app.mywhispr.mac</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>MyWhispr</string>
    <key>CFBundleDisplayName</key>
    <string>MyWhispr</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <!-- MyWhispr lives in the menu bar. The Dock icon is opt-in and is applied at
         runtime by switching the activation policy, so the app must start without
         one rather than flashing a Dock icon on every launch. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>MyWhispr records your voice for local transcription.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>MyWhispr records system audio when you start a meeting recording.</string>
    <key>NSAccessibilityUsageDescription</key>
    <string>MyWhispr inserts completed dictation into the text field you selected.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 MyWhispr contributors. MIT licensed.</string>
</dict>
</plist>
